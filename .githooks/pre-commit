#!/bin/sh
# Seeky pre-commit hook: check-only formatting gate (rustfmt + Prettier).
# Enabled by `npm install` in apps/desktop (sets core.hooksPath to .githooks).
# It never rewrites files. CI runs the same checks, so skipping the hook only
# moves the failure to the pull request.
#
# The checks run on the working tree of the affected project, not on the
# staged snapshot: stage the formatted files before committing.

set -u

WEB_DIR="apps/desktop"

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

status=0

if printf '%s\n' "$staged" | grep -Eq '(\.rs|(^|/)rustfmt\.toml)$'; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found; cannot check Rust formatting." >&2
    status=1
  elif ! cargo fmt --all --check >/dev/null 2>&1; then
    echo "pre-commit: Rust code is not formatted. Fix with:" >&2
    echo "  cargo fmt --all" >&2
    status=1
  fi
fi

if printf '%s\n' "$staged" |
  grep -Eq "^$WEB_DIR/(.*\.(ts|tsx|js|jsx|mjs|cjs|css|html|json|ya?ml)|\.prettierrc\.json|\.prettierignore)$"; then
  if [ ! -x "$WEB_DIR/node_modules/.bin/prettier" ] &&
    [ ! -f "$WEB_DIR/node_modules/.bin/prettier.cmd" ]; then
    echo "pre-commit: Prettier is not installed. Run: npm --prefix $WEB_DIR install" >&2
    status=1
  elif ! npm --prefix "$WEB_DIR" run --silent format:check >/dev/null 2>&1; then
    echo "pre-commit: frontend files are not formatted. Fix with:" >&2
    echo "  npm --prefix $WEB_DIR run format" >&2
    status=1
  fi
fi

exit $status
