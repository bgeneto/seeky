{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seeky",
  "version": "0.1.0",
  "identifier": "ai.seeky.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seeky — local semantic search",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0f1216"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/gety-embed-v0/openvino/model.xml",
      "resources/models/gety-embed-v0/openvino/model.bin"
    ]
  }
}
